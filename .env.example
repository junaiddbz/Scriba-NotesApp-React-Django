# Django Settings
DEBUG=False
SECRET_KEY=change-this-to-a-random-secure-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=notesapp
DB_USER=postgres
DB_PASSWORD=secure_password_here
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://postgres:secure_password_here@db:5432/notesapp

# Redis Configuration
REDIS_PASSWORD=redis_password_here
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_URL=redis://:redis_password_here@redis:6379/2
CELERY_BROKER_URL=redis://:redis_password_here@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redis_password_here@redis:6379/1

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=your-bucket.s3.amazonaws.com

# Email / SendGrid Configuration
SENDGRID_API_KEY=your_sendgrid_api_key
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
EMAIL_BACKEND=anymail.backends.sendgrid.EmailBackend

# OAuth - Google
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret

# OAuth - GitHub
GITHUB_OAUTH_CLIENT_ID=your_github_app_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_app_secret

# Sentry Error Tracking
SENTRY_DSN=https://your_sentry_key@sentry.io/your_project_id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Frontend Configuration
FRONTEND_URL=https://yourdomain.com

# Container Configuration
WEB_PORT=8000
NGINX_PORT=80
NGINX_SSL_PORT=443
REDIS_PORT=6379
DB_PORT=5432
FLOWER_PORT=5555

# Logging
LOG_LEVEL=info

# Timezone
TZ=UTC

# Security
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
